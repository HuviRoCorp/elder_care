# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string for the eldercare database.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/eldercare

# Secret used to sign access tokens. Use 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change_me

# Port the backend listens on.
PORT=5000

# Optional token lifetimes. Defaults shown.
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL_DAYS=30

# Country assumed when someone types a phone number with no country code.
# Numbers already written in international form (+... or 00...) are accepted
# for any country whatever these say. Defaults shown: India.
# DEFAULT_CALLING_CODE=91
# DEFAULT_NATIONAL_DIGITS=10

# --- Emergency contact notifications (Phase 1 step 3) ---------------------
# Every channel below is optional. Push works with none of this set. Email,
# SMS and voice stay wired but inactive until their own variables are filled
# in — no code change needed, only .env. An inactive channel still records a
# `notifications` row for every attempt, with a failure reason that names
# exactly which variable is missing.

# Email — sign up free at resend.com, create an API key.
# RESEND_API_KEY=re_...
# Sender address. Resend's own sandbox address works with no domain
# verification; replace once your own sending domain is verified there.
# EMAIL_FROM_ADDRESS=onboarding@resend.dev

# SMS and voice call — Twilio. Create a free trial account at twilio.com,
# buy/claim a number capable of SMS and voice.
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM_NUMBER=+1...
#
# IMPORTANT — India: a Twilio trial number can text/call your own verified
# number immediately, but SMS to real Indian mobile numbers in production
# requires DLT (Distributed Ledger Technology) registration with the telecom
# regulator first — an entity registration, a sender header, and a message
# template, each needing approval. This is the client's responsibility to
# arrange and takes on the order of weeks; it does not block developing or
# testing this feature, only sending real SMS to real Indian numbers later.

# How long an active, unacknowledged alert waits before escalating to the
# next emergency contact. Whole minutes. Defaults to 5.
# ESCALATION_INTERVAL_MINUTES=5
